#!/bin/bash

trap "clear; exit 0" INT

show_live_time_dialog() {
    name="$1"
    tz="$2"

    while true; do
        time_now=$(TZ="$tz" date +"%a, %d %b %Y %H:%M:%S")

        printf "Timezone: %s\n\nCurrent Time:\n%s\n\nPress ESC to return to Menu, or 'q' to Exit." \
            "$tz" "$time_now" | dialog --title "LIVE CLOCK - $name" --infobox "$(cat)" 12 50

        read -rsn1 -t 1 key
        if [[ $key == $'\e' ]]; then
            return 0
        elif [[ $key == "q" ]]; then
            clear
            exit 0
        fi
    done
}

while true; do
    exec 3>&1
    choice=$(dialog --clear \
        --title "TIMEZONE VIEWER" \
        --cancel-label "Exit" \
        --menu "Select a timezone using 1-6 or arrow keys or cursor and 7 + enter for exit or use the Exit button:" \
        18 60 10 \
        1 "India (Asia/Kolkata)" \
        2 "UK (Europe/London)" \
        3 "Dubai (Asia/Dubai)" \
        4 "Hong Kong (Asia/Hong_Kong)" \
        5 "Melbourne (Australia/Melbourne)" \
        6 "Japan (Asia/Tokyo)" \
        EXIT "Exit Program" \
        2>&1 1>&3)
    exec 3>&-

    [[ -z "$choice" || "$choice" == "EXIT" ]] && clear && exit 0

    case "$choice" in
        1) show_live_time_dialog "India" "Asia/Kolkata" ;;
        2) show_live_time_dialog "UK" "Europe/London" ;;
        3) show_live_time_dialog "Dubai" "Asia/Dubai" ;;
        4) show_live_time_dialog "Hong Kong" "Asia/Hong_Kong" ;;
        5) show_live_time_dialog "Melbourne" "Australia/Melbourne" ;;
        6) show_live_time_dialog "Japan" "Asia/Tokyo" ;;
    esac
done
