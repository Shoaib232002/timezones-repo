#!/bin/bash

RED="\033[31m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
BOLD="\033[1m"
RESET="\033[0m"

show_live_time() {
    tz="$1"

    while true; do
        clear
        echo -e "${CYAN}${BOLD}==============================="
        echo -e "   LIVE CLOCK → $tz"
        echo -e "===============================${RESET}"
        echo
        echo -e "${YELLOW}Current Time:${RESET}"
        echo -e "${GREEN}$(TZ="$tz" date)${RESET}"
        echo
        echo -e "${CYAN}Press ESC to return to menu...${RESET}"

        read -rsn1 -t 1 key
        [[ $key == $'\e' ]] && break
    done
}

while true; do
    HEIGHT=15
    WIDTH=50
    CHOICE_HEIGHT=7
    TITLE="TIMEZONE VIEWER"
    MENU="Select a timezone using cursor or arrow keys and enter:"

    OPTIONS=(
        1 "India (Asia/Kolkata)"
        2 "UK (Europe/London)"
        3 "Dubai (Asia/Dubai)"
        4 "Hong Kong (Asia/Hong_Kong)"
        5 "Melbourne (Australia/Melbourne)"
        6 "Japan (Asia/Tokyo)"
    )

   
    CHOICE=$(dialog --clear \
                    --title "$TITLE" \
                    --menu "$MENU" \
                    $HEIGHT $WIDTH $CHOICE_HEIGHT \
                    "${OPTIONS[@]}" \
                    2>&1 >/dev/tty)

   
    if [ $? -ne 0 ]; then
        clear
        exit 0
    fi

    case "$CHOICE" in
        1) show_live_time "Asia/Kolkata" ;;
        2) show_live_time "Europe/London" ;;
        3) show_live_time "Asia/Dubai" ;;
        4) show_live_time "Asia/Hong_Kong" ;;
        5) show_live_time "Australia/Melbourne" ;;
        6) show_live_time "Asia/Tokyo" ;;
    esac
done
